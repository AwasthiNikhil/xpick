{
  "manifest_version": 3,
  "name": "XPath Inspector & Hover Grabber",
  "version": "1.0",
  "description": "Inspect and grab XPath from any element, including hover states and transient dropdowns.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XPath Grabber"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}